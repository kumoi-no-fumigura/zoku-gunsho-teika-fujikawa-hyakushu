   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山路梅花",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "にほひつる枕にさむき梅からさくらき雨夜のほしやいつらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "梅薫夜風",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "年月もうつりに遣翌な柳陰水ゆく川のすゑ春世の春",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水造古柳",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "遣ふよりや木のめもわかの桜花かやのいさめのはる雨のこえ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "両中侍花",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "玉きはかつ荒れて吹岡のちらすは千世ものへ来り路人",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野花智人",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "一色まかふよことの雲やましならんみろは桜の四方の山の場",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠望山花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "一あかなくのをのか衣々吹風に苔のみとりも花そわかるし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁庭庵花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "一里はあれ庭のさくらもふりはてゝるそかれときをとふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "故郷夕岡",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "ゆく春のなかれてはやきこおの河霞のふちにくもる月影",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河上春同",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "春の夜の八丁ゑの鳥もなかぬまにたのむのかりのいそき立らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深夜飯屋",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "松風の声もそなたにおひくらんかゝれる爰のすゑもみたれて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤花随風",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "橋はしち色に出けるもの葉をいわてやにほふやまふきの花",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋辺新登",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "今日は猶妻をしのゝ友船の春のさかひをわかれすもかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "舟中暮春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "一卯花の枝はたいゝの露をみよとはれしみちのむかし語は",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花隠路",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "昨日こそ霞たちしかほとゝきす又うちはふくこそのふるこゑ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初聞郭公",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "〽この里は待もまたすもほとゝきす山とひこゆる殿よりすくすな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家時鳥",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "あくなよりけふひくあゆめ池水にをのか五月そなれてわかるら",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池朝菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "こかるとも煙もみめし時しらぬ竹のは山のおくのかやり火",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閑居蚊火",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "袖のかは花橘にのこれともたへ夏つれなきゆめの面かけ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "慮橋驚夢",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "わひ人のほさぬためしや五月雨の雫にくたすうろて来歳",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "あたしのゝをかやかにはたかためさみたれ初たるこれをまつらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野夕夏草",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "日影さすささたとくちる色もなし谷のほたるそ光なりける",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "│御庭並火",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "夕立ま袖も去ほくのかり衣かつうつりゆくをちかたのくも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行路夕立",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "穣きぬといふはかりなるもきふにあさねの風の心はかうに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首初秋朝風",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "一天河にやつきは名のみかさなれど雲の衣やよそにぬるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閏月七夕",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "一煉萩に玉ぬく野への夕露をよしやみたさてやとなからみん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野亭夕萩",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "〽まわたる萩のすゑはのほの〳〵と月の入江をいつる年人",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江辺曙萩",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "秋かせの雲にましれる峰こへて外山の里にかりは朱にけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家初丁",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "一淡路かだ新なき花をかさしも哥いつるもをそくいさよひの月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海上侍同",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "袖ちかき色やみとりの松風にぬるゝかほなる月そすくなき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松間夜月",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "岡ならていたくな侘そとは色もみやさの月を人やとはまし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深山見月",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "武蔵野につらぬきとめぬ白露の草はこなから月そこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草露映同",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "相坂はかへりかん日を毎のみても空ゆく月の関もりはなき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "開路惜月",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "山里の竹よりほかのわか友はよるなく鹿の庭の庭の底の",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿声夜友",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "露霞のおくての山田吹かせのもよほすかたに衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一田家持衣",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "一夕方にことゝひ侘ぬすみ田河わか友舟もありやなしやと",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古渡龍霧",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "一宮城野は木のした露もほしはてゝはらひもやらぬ四方の秋風",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "桃風まれ",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "みたれ落る翁の籬の下露に涙色なるまつむしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "難下関虫",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "山川のゑくれてはるゝもみち葉におられぬ水も色まさりつゝ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉写水",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "山めくるしくれのかくのもみち世のいくちしほとかこかれいつらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "秋風のうは葉にためぬ白露にしほらてひたす朝かほのはな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "露庭権花",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "大井海ゐせきの浪の花の色をうつろひすつるきしのしら菊",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河辺南岡",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "又人のとはねも嬉し草にたになれてはおしき。あきのわかれを",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "独惜春秋",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "舞ふそへてさうそしくれの音陰雷神無月とは人に立くれしめ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬時雨",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "朝霜の庭のたち案思思るしれをのかしたなる苺のこゝろを",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜埋落葉",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "真木の屋にあられの音もとたへつか風のゆくゑにおひく村雲",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "屋上宍裏",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "むかしへやかに山姫の布さらす諸ふりまかへつもるしら雪",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古寺初雪",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "我門は遣ふ元人に立られぬ雪のこゝろに庭をまかせて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭雪獣人",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "住吉の松やいつくとふか雪におかめも真らぬとをつしま人",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺松雪",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "菱の葉も下におれはてゝ三嶋江の入口は同つかれもさはらて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水郷寒蓋",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "唐の海や月待からの小夜ちとりいつれの繪をさしてなくらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖上千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "せきとめす松を嵐のはらふ夜も鴨の青羽の霜そかさなる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒夜水馬",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "いまいくかう地出か浪のわつ岡も谷のこほりの下にまつかん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮間水",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "一暮あまりその里人にことゝはんおかし岡への松もこゆやと",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初尋縁恋",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "秋の霜にうつろふ岡の名はかりもかけすにむしのなく音からては",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞声忍恋",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "妹かけてふり敷木のはいくかへりむおしき春の色にもゆらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "契経年恋",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "にりかまこと世のいつはりのいかならんたのまれぬへき筆の跡かな",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "疑真偽恋",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "打おひし煙くらへにもへまさるかもひのたきら身はこかれつゝ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返事増慈",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "色にいてゝいひなしほりそ梅戸のあけなかしなる春の袂を",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "被厭賤忘",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "ことちのへのいてのしからみひきむすひ忘れはつらしい本田の前",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "途中契恋",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "おもひやれむくらのかとのさしおからきてかへさるゝ度のころもて",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "従門帰応",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "いかにせんたのめしさとを住の江の岸におふてふ草にまかへて",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "天住所恋",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "おからへにあらはあふよと手向して年のをいのに森のしめ縄",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "依恋新身",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "わたつ海のゆつゝ浦々にみつしほのこへてすくなき中のかよひち",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隔遠踏恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "かりそめのたか名のりそになひくらんわか身のかたはまへぬけふりを",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "借人名恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "あふひ草人のかさしかなはかりも名をたにかれてとふかたもなし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶不知応",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "もしほ草あまのすさひにかきまへぬ里の音るへの心くらへに",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "立恨絶恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "明やらぬ音のねふかく置霜にね覚くるしき世々のふること",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁更寝覚",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "植をきしわか物からの庭の松ゆふへは風のこゑそくやしき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄暮松風",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "色かへぬ青葉の竹のうきふしに身をしる雨のあはれ世中",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "両中縁竹",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "はや瀬川岩うつ浪の白妙に苔のみとりの色そつれなき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浪洗石苔",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "一比良の山嶺の木からしはらぬ夜にひきよくも月を待かな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "高山侍月",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "雲ふかきあたりの山につゝまれて音のみかつる瀧の白玉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中助水",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "一妹のかのきに瀧川の名影木の葉もうかすくもるはかりは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河水流清",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "〽おなし野の霞も雪も分なれぬはつねの小松まつ火芝声",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春秋野遊",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "ゆく人のかた見もかたにをく露をふきおはらひそ闇の秋風",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路行客",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "暮かゝる四方の木のもの山風にをのれゑほるゝしもの袖かな",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家夕嵐",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "故郷を忍ふる人やわたしけんさてもせはれぬ谷のかれはし",
   "kana": "",
   "speaker": "川のはしう",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家人稀",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "去るらめやたゆたふ舟の波間よりこゆるこしまのもとの心を",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海路眺望",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "ゆふつくに宿かり初し影なからいく有田の友となるらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一月四軒中友",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "旅衆ぬくや玉のをよるの雨は袖に又たれて夢もむすはす",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿夜雨",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "明ぬとてとまり漕出か友舟のほしのまきれに雲そわかなら",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺暁雲",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "まとろめめはいやはかなゝる夢の内に身をいくよとて覚ぬ歎そ",
   "kana": "",
   "speaker": "くれ竹か",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄夢無常",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "引捨るためしもかなしかきつめしをとろか道のもとの朽葉に",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄草述懐",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "一九重のとのゑのあふち忘るなよむそちの友は朽ちやらぬと",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一寄木述懐",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "天の戸のあくる日母に忍ふとてしらぬむかしは色もかへらす",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "通日懐旧",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "いつるより神もさこそはねかふらめ君あきらかに民やすくとは",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "社頭祝言",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "東路に春やきぬらん開の戸もあくれはかすむあしからの山",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路早春",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "かすえぬと氷も今朝やとけぬらん汀にちかき志賀のうらなみ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖上朝霞",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "昨日まてそれとはみえし山本の梢もしらすかす無春かな",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞隔遠樹",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "鶯は梅さく里匁のむらん宿さたまらぬ旅そかなしき",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733742",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "羇中閉党",
   "kotobagaki": ""
  }
 ],
